# NOVA — env untuk HP Android (proot Ubuntu). Simpan sebagai /opt/nova/.env, mode 600.
# WAJIB: kunci API Gemini (jangan ditaruh di repo/publik)
NOVA_GEMINI_KEY=

# OPSIONAL: sesi WhatsApp hasil pairing (base64 dari nova-wa-session.b64).
# Kosongkan kalau mau pindai QR baru di HP.
NOVA_WA_SESSION_B64=

# Batas tunggu pairing QR (detik) saat sesi belum ada
NOVA_PAIR_WAIT=300

# Zona waktu
TZ=Asia/Makassar
